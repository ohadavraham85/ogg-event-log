// Firestore security rules for the team log. Paste into Firebase console → Firestore → Rules → Publish.
// Replace OWNER_EMAIL with the owner's e-mail (lower case) before publishing — keep it out of the repo.
// Access: only signed-in users with a verified e-mail who are the owner or listed in /members.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail()  { return request.auth.token.email.lower(); }
    function isOwner()  { return signedIn() && myEmail() == "OWNER_EMAIL"; }
    function isMember() { return signedIn() && (isOwner() || exists(/databases/$(db)/documents/members/$(myEmail()))); }
    function isAdmin()  { return isOwner() || (isMember() && get(/databases/$(db)/documents/members/$(myEmail())).data.role == "admin"); }

    match /members/{email} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /events/{id} {
      allow read: if isMember();
      // every write is stamped with the server time and the writer; no hard deletes (soft delete via _del)
      // deleting (setting _del) is for admins only
      allow create, update: if isMember()
        && request.resource.data.id == id
        && request.resource.data._upd == request.time
        && request.resource.data._by == myEmail()
        && (request.resource.data.get('_del', false) != true || isAdmin());
      allow delete: if false;
    }
    // files attached to tasks (one document each): team members read and add; only an admin removes
    match /files/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data._upd == request.time
        && request.resource.data._by == myEmail();
      allow delete: if isAdmin();
    }
    match /meta/{doc} {
      allow read: if isMember();
      // tasks (task-<id>): only an admin may mark one deleted; no hard deletes of shared data
      allow create, update: if isMember()
        && (!doc.matches('task-.*') || request.resource.data.get('_del', false) != true || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
